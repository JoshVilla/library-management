{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "moduleResolution": "node",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "src"],
  "exclude": ["node_modules"]
}
